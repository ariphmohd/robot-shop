# Terraform and OpenTofu
# Working directories, state, and plan outputs can contain provider binaries or
# plaintext credentials. Provider dependency locks are deliberately tracked.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*tfplan*
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*secret*.tfvars
*secrets*.tfvars
*.secret.tfvars
local.tfvars

# Keep dependency selections reproducible.
!**/.terraform.lock.hcl

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
aws_credentials

# Application dependencies and build artefacts
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/__pycache__/
*.py[cod]
*.so
.pytest_cache/
**/venv/
**/.venv/
**/env/
**/ENV/
**/build/
**/dist/
**/*.egg-info/
**/target/
*.class
**/bin/
*.exe
*.dll
*.dylib
Gopkg.lock

# Container and Helm client artefacts
.docker/
*.tgz
.helm/

# OS and editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
*.bak
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*-private.*

# Eclipse project metadata generated by the shipping service's Java build.
.classpath
.project
.settings/

# Local recovery outputs; prefer protected storage outside this checkout.
/backups/
/recovery-private/
/kind-logs/
