[Unit]
Description=Refresh Robot Shop Kind ECR pull credentials

[Service]
Type=oneshot
TimeoutStartSec=150
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KUBECONFIG=%h/.kube/config
WorkingDirectory=%h/projects/robot-shop
ExecStart=/usr/bin/python3 %h/projects/robot-shop/scripts/kind/refresh-ecr-secret.py
Restart=on-failure
RestartSec=5min
