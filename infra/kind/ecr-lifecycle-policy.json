{
  "rules": [
    {
      "rulePriority": 1,
      "description": "Keep the newest three CI sha-tagged image versions",
      "selection": {
        "tagStatus": "tagged",
        "tagPrefixList": [
          "sha-"
        ],
        "countType": "imageCountMoreThan",
        "countNumber": 3
      },
      "action": {
        "type": "expire"
      }
    },
    {
      "rulePriority": 2,
      "description": "Expire untagged images older than one day when no retained manifest list references them",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 1
      },
      "action": {
        "type": "expire"
      }
    }
  ]
}
